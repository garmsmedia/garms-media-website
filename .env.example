# Copy to .env.local for local development. Never commit real values.
# All variables are OPTIONAL — the site builds and runs without any of them.

# Public URL of the site (used for canonical URLs, Open Graph, sitemap).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# --- Contact form lead storage (Supabase) — SERVER ONLY, never NEXT_PUBLIC_ ---
# When both are set, contact form submissions are saved to the contact_leads table.
# When empty, the form shows an honest "not connected yet" message and stores nothing.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
